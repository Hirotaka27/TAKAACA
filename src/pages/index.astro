---
import AppLayout from '../layouts/AppLayout.astro';
import { createClient } from '../lib/supabase/server';
import {
  todayWib,
  formatDateWib,
  CATEGORY_LABEL,
  CATEGORY_CHIP,
  type AgendaRow,
  type ProfileRow,
  type Category,
} from '../lib/agenda';
import { publicUrlFor } from '../lib/storage';

const supabase = createClient(Astro);
const {
  data: { user },
} = await supabase.auth.getUser();

const [{ data: agendaData }, { data: profileData }, { data: photoData }] = await Promise.all([
  supabase
    .from('agendas')
    .select('*')
    .order('event_date', { ascending: true })
    .order('start_time', { ascending: true }),
  supabase.from('profiles').select('*'),
  supabase.from('photos').select('*').order('created_at', { ascending: false }).limit(6),
]);

const agendas = (agendaData ?? []) as AgendaRow[];
const profiles = (profileData ?? []) as ProfileRow[];
const photos = (photoData ?? []).map((p) => ({
  ...p,
  url: p.web_view_link || publicUrlFor(p.storage_path),
}));

const me = profiles.find((p) => p.id === user?.id) ?? null;
const partner = profiles.find((p) => p.id !== user?.id) ?? null;

const today = todayWib();
const todayList = agendas.filter((a) => a.event_date === today && a.status !== 'cancelled');

const upcoming = agendas
  .filter((a) => a.event_date > today && a.status === 'pending')
  .slice(0, 6);

const weekEnd = todayWib(new Date(Date.now() + 6 * 86400000));
const weekAll = agendas.filter((a) => a.event_date >= today && a.event_date <= weekEnd);
const weekDone = weekAll.filter((a) => a.status === 'done').length;
const pendingCount = agendas.filter((a) => a.status === 'pending').length;

const hour = new Date(Date.now() + 7 * 3600 * 1000).getUTCHours();
const greeting = hour < 11 ? 'Selamat pagi' : hour < 15 ? 'Selamat siang' : hour < 18 ? 'Selamat sore' : 'Selamat malam';
const name = me?.display_name ?? 'Kamu';
const emoji = me?.avatar_emoji ?? '💙';

function chipClass(category: Category) {
  return CATEGORY_CHIP[category] ?? 'chip-yellow';
}
---

<AppLayout title="Dashboard" page="dashboard">
  <section class="mb-6">
    <div class="glass flex flex-wrap items-center justify-between gap-4 rounded-3xl p-5 sm:p-6">
      <div>
        <p class="text-sm font-semibold text-ink-soft">{greeting},</p>
        <h1 class="font-display text-2xl font-bold sm:text-3xl">{name} {emoji}</h1>
        <p class="mt-1 text-sm text-ink-soft">
          {formatDateWib(today)} · {todayList.length} agenda hari ini
        </p>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex -space-x-3 text-2xl">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sky-100 ring-2 ring-white">{emoji}</span>
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-blush-100 ring-2 ring-white"
            >{partner?.avatar_emoji ?? '💗'}</span
          >
        </div>
        <a href="/agenda" class="btn-primary rounded-2xl px-4 py-2.5 text-sm font-bold">+ Agenda</a>
      </div>
    </div>
  </section>

  <section class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
    <div class="glass rounded-3xl p-4">
      <p class="text-xs font-semibold text-ink-faint">Hari ini</p>
      <p class="font-display text-2xl font-bold text-sky-500">{todayList.length}</p>
    </div>
    <div class="glass rounded-3xl p-4">
      <p class="text-xs font-semibold text-ink-faint">Berjalan</p>
      <p class="font-display text-2xl font-bold text-blush-500">{pendingCount}</p>
    </div>
    <div class="glass rounded-3xl p-4">
      <p class="text-xs font-semibold text-ink-faint">Selesai 7 hari</p>
      <p class="font-display text-2xl font-bold text-sky-500">{weekDone}/{weekAll.length}</p>
    </div>
    <div class="glass rounded-3xl p-4">
      <p class="text-xs font-semibold text-ink-faint">Foto</p>
      <p class="font-display text-2xl font-bold text-blush-500">{photos.length}</p>
    </div>
  </section>

  <div class="grid gap-5 lg:grid-cols-2">
    <section class="glass rounded-3xl p-4 sm:p-5">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="font-display text-lg font-bold">Agenda hari ini</h2>
        <a href="/agenda" class="text-xs font-bold text-sky-500 hover:underline">Lihat semua</a>
      </div>

      {
        todayList.length === 0 ? (
          <div class="rounded-2xl border border-dashed border-sky-200 bg-white/50 px-4 py-8 text-center">
            <p class="text-sm font-semibold text-ink-soft">Hari ini bebas agenda 🌤️</p>
            <a href="/agenda" class="btn-soft mt-3 inline-block rounded-xl px-4 py-2 text-xs font-bold">
              Rencanakan sesuatu
            </a>
          </div>
        ) : (
          <ul class="space-y-3">
            {todayList.map((a) => (
              <li class="rounded-2xl border border-white bg-white/75 p-3.5 shadow-sm">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <span class:list={['rounded-full px-2.5 py-0.5 text-[11px] font-bold', chipClass(a.category)]}>
                      {CATEGORY_LABEL[a.category] ?? a.category}
                    </span>
                    <h3
                      class:list={[
                        'mt-1.5 font-display text-base font-bold',
                        a.status === 'done' && 'text-ink-faint line-through',
                      ]}
                    >
                      {a.title}
                    </h3>
                    <p class="mt-1 text-xs font-semibold text-ink-faint">
                      {a.start_time ? `${a.start_time}${a.end_time ? ` – ${a.end_time}` : ''}` : 'Seharian'}
                      {a.assignee === null
                        ? ' · berdua'
                        : ` · ${a.assignee === user?.id ? (me?.display_name ?? 'aku') : (partner?.display_name ?? 'pasangan')}`}
                    </p>
                  </div>
                  <button
                    type="button"
                    data-toggle={a.id}
                    data-status={a.status}
                    class:list={[
                      'grid h-9 w-9 shrink-0 place-items-center rounded-xl text-sm font-bold transition',
                      a.status === 'done'
                        ? 'bg-sky-300 text-white'
                        : 'bg-white text-ink-faint hover:bg-sky-100 hover:text-sky-500',
                    ]}
                    aria-label="Tandai selesai"
                  >
                    ✓
                  </button>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="glass rounded-3xl p-4 sm:p-5">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="font-display text-lg font-bold">Mendatang</h2>
        <a href="/agenda" class="text-xs font-bold text-sky-500 hover:underline">Kalender</a>
      </div>
      {
        upcoming.length === 0 ? (
          <div class="rounded-2xl border border-dashed border-blush-200 bg-white/50 px-4 py-8 text-center">
            <p class="text-sm font-semibold text-ink-soft">Belum ada agenda berikutnya</p>
          </div>
        ) : (
          <ul class="space-y-3">
            {upcoming.map((a) => (
              <li>
                <a
                  href={`/agenda?date=${a.event_date}`}
                  class="block rounded-2xl border border-white bg-white/75 p-3.5 shadow-sm transition hover:bg-white"
                >
                  <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-ink-faint">{formatDateWib(a.event_date)}</p>
                      <h3 class="mt-0.5 truncate font-display text-base font-bold">{a.title}</h3>
                    </div>
                    <span class:list={['shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-bold', chipClass(a.category)]}>
                      {CATEGORY_LABEL[a.category] ?? a.category}
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  <section class="glass mt-5 rounded-3xl p-4 sm:p-5">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-display text-lg font-bold">Foto terbaru</h2>
      <a href="/photos" class="text-xs font-bold text-sky-500 hover:underline">Galeri</a>
    </div>
    {
      photos.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-sky-200 bg-white/50 px-4 py-8 text-center">
          <p class="text-sm font-semibold text-ink-soft">Belum ada foto tersimpan</p>
          <a href="/photos" class="btn-soft mt-3 inline-block rounded-xl px-4 py-2 text-xs font-bold">
            Buka galeri
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-3 gap-2.5 sm:grid-cols-6">
          {photos.map((p) => (
            <a
              href="/photos"
              class="aspect-square overflow-hidden rounded-2xl bg-sky-50 ring-1 ring-white"
            >
              <img
                src={p.url}
                alt={p.name}
                loading="lazy"
                class="h-full w-full object-cover transition hover:scale-105"
              />
            </a>
          ))}
        </div>
      )
    }
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.toggle;
        const current = btn.dataset.status;
        if (!id) return;
        btn.disabled = true;
        await fetch(`/api/agendas/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: current === 'done' ? 'pending' : 'done' }),
        });
        window.location.reload();
      });
    });
  </script>
</AppLayout>
