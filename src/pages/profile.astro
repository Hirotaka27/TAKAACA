---
import AppLayout from '../layouts/AppLayout.astro';
import EnablePush from '../components/profile/EnablePush';
import { createClient } from '../lib/supabase/server';
import { formatDateWib, type ProfileRow, type AgendaRow } from '../lib/agenda';

const supabase = createClient(Astro);
const {
  data: { user },
} = await supabase.auth.getUser();

const [{ data: profileData }, { data: agendaData }, { data: photoData }] = await Promise.all([
  supabase.from('profiles').select('*'),
  supabase.from('agendas').select('id, status'),
  supabase.from('photos').select('id'),
]);

const profiles = (profileData ?? []) as ProfileRow[];
const me = profiles.find((p) => p.id === user?.id) ?? null;
const partner = profiles.find((p) => p.id !== user?.id) ?? null;
const agendas = (agendaData ?? []) as Pick<AgendaRow, 'id' | 'status'>[];
const photoCount = (photoData ?? []).length;

const total = agendas.length;
const done = agendas.filter((a) => a.status === 'done').length;
const cancelled = agendas.filter((a) => a.status === 'cancelled').length;

const EMOJIS = ['💙', '💗', '🌸', '🌙', '⭐', '🦋', '🧸', '🍓', '🫶', '🌷', '☁️', '🩵'];

const form = {
  name: me?.display_name ?? '',
  emoji: me?.avatar_emoji ?? '💙',
  anniversary: me?.anniversary_date ?? '',
  reminder: me?.default_reminder_minutes ?? 60,
};

const nextAnniversary = (() => {
  const date = me?.anniversary_date;
  if (!date) return null;
  const [, m, d] = date.split('-').map(Number);
  const now = new Date();
  let year = now.getUTCFullYear();
  const candidate = new Date(Date.UTC(year, m - 1, d, 12));
  const today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
  if (candidate.getTime() < today) {
    year += 1;
  }
  const days = Math.round(
    (Date.UTC(year, m - 1, d, 12) - today) / 86400000,
  );
  return days;
})();
---

<AppLayout title="Profil" page="profile">
  <div class="mb-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Menu</p>
    <h1 class="font-display text-2xl font-bold sm:text-3xl">Profil</h1>
  </div>

  <div class="grid gap-5 lg:grid-cols-3">
    <!-- Kolom kiri: akun + pasangan -->
    <div class="space-y-5 lg:col-span-1">
      <section class="glass rounded-3xl p-5 text-center">
        <span id="emoji-preview" class="mx-auto grid h-20 w-20 place-items-center rounded-3xl bg-sky-100 text-4xl"
          >{form.emoji}</span
        >
        <h2 id="name-preview" class="mt-3 font-display text-xl font-bold">{form.name}</h2>
        <p class="text-sm text-ink-soft">{user?.email}</p>
        {
          nextAnniversary !== null && (
            <p class="mt-3 inline-block rounded-full chip-yellow px-3 py-1 text-xs font-bold">
              Anniversary berikutnya {nextAnniversary === 0 ? 'hari ini' : `lagi ${nextAnniversary} hari`}
            </p>
          )
        }
      </section>

      <section class="glass rounded-3xl p-5">
        <h2 class="mb-3 font-display text-lg font-bold">Pasangan</h2>
        {
          partner ? (
            <div class="flex items-center gap-3">
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-blush-100 text-3xl">
                {partner.avatar_emoji ?? '💗'}
              </span>
              <div>
                <p class="font-semibold">{partner.display_name ?? 'Pasangan'}</p>
                <p class="text-xs text-ink-faint">
                  {partner.anniversary_date
                    ? `Anniversary ${formatDateWib(partner.anniversary_date, { weekday: undefined })}`
                    : 'Belum mengatur tanggal anniversary'}
                </p>
              </div>
            </div>
          ) : (
            <p class="text-sm text-ink-soft">Belum ada pasangan terhubung.</p>
          )
        }
      </section>

      <section class="glass rounded-3xl p-5">
        <h2 class="mb-3 font-display text-lg font-bold">Statistik</h2>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-2xl bg-white/75 p-3 text-center">
            <p class="font-display text-2xl font-bold text-sky-500">{done}</p>
            <p class="text-[11px] font-semibold text-ink-faint">Selesai</p>
          </div>
          <div class="rounded-2xl bg-white/75 p-3 text-center">
            <p class="font-display text-2xl font-bold text-blush-500">{total - done - cancelled}</p>
            <p class="text-[11px] font-semibold text-ink-faint">Berjalan</p>
          </div>
          <div class="rounded-2xl bg-white/75 p-3 text-center">
            <p class="font-display text-2xl font-bold text-butter-400">{cancelled}</p>
            <p class="text-[11px] font-semibold text-ink-faint">Batal</p>
          </div>
          <div class="rounded-2xl bg-white/75 p-3 text-center">
            <p class="font-display text-2xl font-bold text-sky-500">{photoCount}</p>
            <p class="text-[11px] font-semibold text-ink-faint">Foto</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Kolom kanan: form + integrasi -->
    <div class="space-y-5 lg:col-span-2">
      <section class="glass rounded-3xl p-5">
        <h2 class="mb-4 font-display text-lg font-bold">Edit profil</h2>
        <form id="profile-form" class="space-y-4">
          <div>
            <label for="p-name" class="mb-1.5 block text-sm font-semibold">Nama</label>
            <input
              id="p-name"
              name="name"
              required
              maxlength="60"
              value={form.name}
              class="w-full rounded-2xl border border-sky-100 bg-white/80 px-4 py-2.5 text-sm outline-none focus:border-sky-300 focus:ring-2 focus:ring-sky-200"
            />
          </div>

          <div>
            <span class="mb-1.5 block text-sm font-semibold">Avatar</span>
            <div class="flex flex-wrap gap-2" id="emoji-picker">
              {
                EMOJIS.map((e) => (
                  <button
                    type="button"
                    data-emoji={e}
                    class:list={[
                      'grid h-11 w-11 place-items-center rounded-2xl text-xl transition',
                      e === form.emoji ? 'bg-sky-200 ring-2 ring-sky-400' : 'bg-white/75 hover:bg-white',
                    ]}
                  >
                    {e}
                  </button>
                ))
              }
            </div>
            <input type="hidden" name="emoji" id="p-emoji" value={form.emoji} />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="p-anniv" class="mb-1.5 block text-sm font-semibold"
                >Tanggal anniversary</label
              >
              <input
                id="p-anniv"
                name="anniversary"
                type="date"
                value={form.anniversary}
                class="w-full rounded-2xl border border-sky-100 bg-white/80 px-4 py-2.5 text-sm outline-none focus:border-sky-300 focus:ring-2 focus:ring-sky-200"
              />
            </div>
            <div>
              <label for="p-rem" class="mb-1.5 block text-sm font-semibold"
                >Pengingat default</label
              >
              <select
                id="p-rem"
                name="reminder"
                class="w-full rounded-2xl border border-sky-100 bg-white/80 px-4 py-2.5 text-sm outline-none focus:border-sky-300 focus:ring-2 focus:ring-sky-200"
              >
                <option value="15" selected={form.reminder === 15}>15 menit sebelum</option>
                <option value="30" selected={form.reminder === 30}>30 menit sebelum</option>
                <option value="60" selected={form.reminder === 60}>1 jam sebelum</option>
                <option value="120" selected={form.reminder === 120}>2 jam sebelum</option>
                <option value="1440" selected={form.reminder === 1440}>1 hari sebelum</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary rounded-2xl px-5 py-2.5 text-sm font-bold"
              >Simpan profil</button
            >
            <span id="profile-msg" class="text-sm font-semibold text-sky-500"></span>
          </div>
        </form>
      </section>

      <section class="glass rounded-3xl p-5">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="font-display text-lg font-bold">Foto</h2>
            <p class="text-sm text-ink-soft">
              Kenangan kita tersimpan di penyimpanan aman aplikasi ini - cukup unggah kapan saja,
              tanpa perlu menghubungkan akun lain.
            </p>
          </div>
          <span class="rounded-full bg-sky-200 px-3 py-1 text-xs font-bold text-sky-600">
            {photoCount} foto
          </span>
        </div>

        <div class="flex flex-wrap gap-2.5">
          <a href="/photos" class="btn-primary rounded-2xl px-4 py-2.5 text-sm font-bold"
            >Buka galeri</a
          >
        </div>
      </section>

      <section class="glass rounded-3xl p-5">
        <h2 class="mb-3 font-display text-lg font-bold">Notifikasi</h2>
        <EnablePush client:visible />
      </section>

      <section class="glass rounded-3xl p-5">
        <form method="POST" action="/api/auth/logout">
          <button type="submit" class="btn-ghost rounded-2xl px-4 py-2.5 text-sm font-bold"
            >Keluar dari akun</button
          >
        </form>
      </section>
    </div>
  </div>

  <script>
    const form = document.getElementById('profile-form') as HTMLFormElement | null;
    const emojiInput = document.getElementById('p-emoji') as HTMLInputElement | null;
    const emojiPreview = document.getElementById('emoji-preview');
    const namePreview = document.getElementById('name-preview');
    const msg = document.getElementById('profile-msg');

    document.querySelectorAll<HTMLButtonElement>('#emoji-picker [data-emoji]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const emoji = btn.dataset.emoji ?? '💙';
        if (emojiInput) emojiInput.value = emoji;
        if (emojiPreview) emojiPreview.textContent = emoji;
        document
          .querySelectorAll('#emoji-picker [data-emoji]')
          .forEach((el) => el.classList.remove('bg-sky-200', 'ring-2', 'ring-sky-400'));
        btn.classList.add('bg-sky-200', 'ring-2', 'ring-sky-400');
      });
    });

    const nameField = document.getElementById('p-name') as HTMLInputElement | null;
    nameField?.addEventListener('input', () => {
      if (namePreview) namePreview.textContent = nameField.value || 'Nama kamu';
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form || !msg) return;
      const data = new FormData(form);
      msg.textContent = 'Menyimpan…';
      try {
        const res = await fetch('/api/profile', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            display_name: String(data.get('name') ?? ''),
            avatar_emoji: String(data.get('emoji') ?? '💙'),
            anniversary_date: String(data.get('anniversary') ?? '') || null,
            default_reminder_minutes: Number(data.get('reminder') ?? 60),
          }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error ?? 'Gagal menyimpan.');
        msg.textContent = 'Tersimpan ✓';
        setTimeout(() => {
          window.location.reload();
        }, 700);
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'Gagal menyimpan.';
      }
    });
  </script>
</AppLayout>
