---
import Layout from './Layout.astro';
import { createClient } from '../lib/supabase/server';
import type { ProfileRow } from '../lib/agenda';

interface Props {
  title?: string;
  page: string;
}

const { title = 'Takaaca', page } = Astro.props;

const supabase = createClient(Astro);
const {
  data: { user },
} = await supabase.auth.getUser();

let profile: ProfileRow | null = null;
let partner: ProfileRow | null = null;

if (user) {
  const { data } = await supabase.from('profiles').select('*');
  const rows = (data ?? []) as ProfileRow[];
  profile = rows.find((r) => r.id === user.id) ?? null;
  partner = rows.find((r) => r.id !== user.id) ?? null;
}

const nav = [
  { href: '/', label: 'Dashboard', page: 'dashboard' },
  { href: '/agenda', label: 'Agenda', page: 'agenda' },
  { href: '/history', label: 'History', page: 'history' },
  { href: '/photos', label: 'Foto', page: 'photos' },
  { href: '/profile', label: 'Profil', page: 'profile' },
] as const;

const icons: Record<string, string> = {
  dashboard:
    'M3 12l9-8 9 8M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10',
  agenda:
    'M7 3v3M17 3v3M4 8h16M5 5h14a1 1 0 011 1v13a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1zM8 13h3v3H8z',
  history:
    'M12 8v4l3 2M3.05 11a9 9 0 111.76 5.25M3 16v-5h5',
  photos:
    'M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm3 11l4-5 3 3.5L16.5 13l3.5 4M9 9.5a1.2 1.2 0 110-2.4 1.2 1.2 0 010 2.4z',
  profile:
    'M12 12a4 4 0 100-8 4 4 0 000 8zm-7 8a7 7 0 0114 0',
};

const displayName = profile?.display_name ?? 'Kita';
const avatar = profile?.avatar_emoji ?? '💙';
const partnerName = partner?.display_name ?? 'Pasangan';
---

<Layout title={`${title} · Takaaca`}>
  <div class="min-h-dvh">
    <!-- Sidebar desktop -->
    <aside
      class="glass fixed inset-y-0 left-0 z-40 hidden w-64 flex-col rounded-none border-y-0 border-l-0 px-4 py-6 md:flex"
    >
      <a href="/" class="mb-8 flex items-center gap-3 px-2">
        <span
          class="grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-sky-300 to-blush-300 text-xl shadow-lg shadow-sky-200/60"
          >💐</span
        >
        <span class="font-display text-xl font-bold tracking-tight">Takaaca</span>
      </a>

      <nav class="flex flex-1 flex-col gap-1.5">
        {
          nav.map((item) => {
            const active = page === item.page;
            return (
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-3 rounded-2xl px-3 py-2.5 text-sm font-semibold transition',
                  active
                    ? 'bg-gradient-to-r from-sky-200/80 to-blush-100 text-ink shadow-sm'
                    : 'text-ink-soft hover:bg-white/70 hover:text-ink',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={icons[item.page]} />
                </svg>
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <div class="mt-4 rounded-2xl bg-white/70 p-3">
        <div class="flex items-center gap-3">
          <span class="text-2xl">{avatar}</span>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold">{displayName}</p>
            <p class="truncate text-xs text-ink-faint">♥ {partnerName}</p>
          </div>
        </div>
        <form method="POST" action="/api/auth/logout" class="mt-3">
          <button
            type="submit"
            class="btn-ghost w-full rounded-xl px-3 py-2 text-xs font-semibold"
            >Keluar</button
          >
        </form>
      </div>
    </aside>

    <!-- Konten -->
    <div class="md:pl-64">
      <header
        class="sticky top-0 z-30 border-b border-white/60 bg-white/55 px-4 py-3 backdrop-blur-md md:hidden"
      >
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span
              class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-sky-300 to-blush-300 text-base"
              >💐</span
            >
            <span class="font-display font-bold">Takaaca</span>
          </div>
          <a href="/profile" class="text-xl" aria-label="Profil">{avatar}</a>
        </div>
      </header>

      <main class="mx-auto w-full max-w-6xl px-4 pt-6 pb-28 md:px-8 md:pb-12">
        <slot />
      </main>
    </div>

    <!-- Bottom nav mobile -->
    <nav
      class="glass fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 gap-1 rounded-none border-x-0 border-b-0 px-2 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] md:hidden"
    >
      {
        nav.map((item) => {
          const active = page === item.page;
          return (
            <a
              href={item.href}
              class:list={[
                'flex flex-col items-center gap-1 rounded-xl px-1 py-1.5 text-[11px] font-semibold transition',
                active ? 'bg-sky-100 text-sky-500' : 'text-ink-soft',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={icons[item.page]} />
              </svg>
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</Layout>
