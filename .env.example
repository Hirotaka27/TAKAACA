# Supabase (publik, boleh masuk ke browser)
PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# Supabase service role (SERVER ONLY - jangan pernah dipakai di client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Web Push VAPID (SERVER ONLY)
# Buat: npx web-push generate-vapid-keys  (atau: npm run setup)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Secret untuk Supabase Cron -> /api/cron/reminders (SERVER ONLY)
# Buat: npm run setup
CRON_SECRET=
